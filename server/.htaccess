RewriteRule ^product/[^/]*-13/?$ https://%{HTTP_HOST}/en/termekek/cimkenyomtatok/cab-eos5 [R=301,L]
RewriteRule ^product/[^/]*-14/?$ https://%{HTTP_HOST}/en/termekek/cimkenyomtatok/cab-mach1 [R=301,L]
