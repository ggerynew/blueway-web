# Blueway Trade — statikus weblap Apache-on (FORPSI Linux klaszter).
# A weboldal gyökerébe kell másolni, a feltöltött oldalak mellé.

# ——— Melyik fájl a nyitóoldal ————————————————————————————————————————
# A régi weblap egy PHP-alkalmazás volt, aminek a webgyökerében index.php áll.
# Az Apache alapbeállítása a legtöbb tárhelyen az index.php-t részesíti előnyben
# az index.html-lel szemben, tehát ha a régi fájl ottmarad, továbbra is az
# jelenne meg. Ezért itt kimondjuk, hogy a mi nyitóoldalunk az index.html.
DirectoryIndex index.html index.htm

# ——— Kiterjesztés nélküli URL-ek ————————————————————————————————————
# A weblap linkjei /hu/rolunk alakúak, a fájl viszont hu/rolunk.html.
# GitHub Pages ezt magától feloldja, Apache nem — enélkül minden belső
# hivatkozás 404 lenne.
RewriteEngine On

# ——— HTTPS ————————————————————————————————————————————————————————
# Kapcsold be (vedd le a # jeleket), MIUTÁN a tanúsítvány kiállt és a
# https://blueway.hu betölt. Előbb bekapcsolva minden látogató hibaoldalt
# kapna. Fontos: ennek a két sornak minden más szabály ELŐTT kell állnia,
# különben a lenti átírások [L] jelzője miatt vagy le sem futna, vagy a
# .html-re átírt címre irányítana át.
# RewriteCond %{HTTPS} !=on
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ——— Ami nem való a nyilvánosság elé ——————————————————————————————
# A régi weblap hagyatékából mentések maradtak a webgyökérben — például egy
# 95 MB-os _blueway_old.rar. A domainre átállás pillanatában ezek bárki
# számára letölthetők lennének, és egy régi weblap mentése jellemzően
# konfigurációs fájlt is tartalmaz adatbázis-jelszóval.
#
# A helyes megoldás az, hogy ezek kikerülnek a webgyökérből; ez csak
# biztonsági háló arra az esetre, ha egy ilyen fájl ottmarad vagy később
# visszakerül. A weblapnak egyetlen ilyen kiterjesztésű fájlja sincs.
#
# Miért mod_rewrite és nem <FilesMatch> + Require: a Require új
# AllowOverride jogosultságot igényelne, és ha a tárhely nem adja meg, az
# egész weblap 500-at adna. A mod_rewrite viszont biztosan engedélyezett,
# hiszen a lenti átírások is arra épülnek.
RewriteRule \.(rar|zip|7z|tar|gz|bz2|sql|bak|old|swp|log|inc)$ - [F,L]
RewriteRule (^|/)(\.git|\.env|\.htpasswd)  - [F,L]

# FONTOS: a Next.js egyszerre készít mappát és azonos nevű .html fájlt.
# A /hu útvonalon például MINDKETTŐ létezik: a hu/ mappa (benne az aloldalak)
# és a hu.html (maga a nyitóoldal). 84 ilyen útvonal van, köztük mind a hét
# nyelvi nyitóoldal. Ezért a szabályok nem nézhetik azt, hogy a kért útvonal
# mappa-e — ha azt néznék, az Apache a mappát szolgálná ki, amiben nincs
# index.html, tehát fájllista vagy 403 jönne a nyitóoldalak helyett.
# A döntő feltétel mindenhol az, hogy létezik-e a hozzá tartozó .html.

# Záró perjeles alak: a tartalmat KISZOLGÁLJUK, nem átirányítunk.
#
# Kézenfekvő lenne a /hu/ címet a /hu-ra irányítani, de ezen a kiszolgálón
# az végtelen körhöz vezet. A mod_dir itt előbb fut, mint a mi átírásaink:
# a /hu-t — ami mappa is, mert a Next.js azonos néven mappát és .html-t is
# készít — átdobja /hu/-ra, a perjelet levágó szabály pedig vissza /hu-ra.
# Élesben ez "Maximum (50) redirects followed" hibával állt elő minden
# nyelvi nyitóoldalon.
#
# Belső átírással a kör nem jön létre: a /hu/ egyszerűen a hu.html tartalmát
# adja. A /hu-ból így egy átirányítás lesz a /hu/-ra, utána 200.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ $1.html [L]

# A Next.js minden oldalhoz készít egy azonos nevű .txt fájlt is — ez a
# böngészőn belüli lapozás adatcsomagja. A kiszolgálón be van kapcsolva a
# MultiViews tartalom-egyeztetés, ami a kiterjesztés nélküli címre MAGA
# választ változatot, és a .txt-t adja a .html helyett. A látogató ilyenkor
# nyers kódot lát a weblap helyett.
#
# Ez a szabály visszatereli az ilyen kérést a .html-re. Csak akkor fut le, ha
# a LÁTOGATÓ nem .txt-t kért: a robots.txt és a lapozás adatcsomagjai így
# változatlanul elérhetők maradnak.
RewriteCond %{REQUEST_URI} !\.txt$
RewriteRule ^(.*)\.txt$ $1.html [L]

# /hu/rolunk -> hu/rolunk.html, ha a .html létezik és nincs pontos találat.
#
# A cél RELATÍV ($1.html), nem abszolút (/$1.html). A .htaccess-ben az
# abszolút alak kétértelmű: az Apache fájlrendszerbeli útvonalként is
# értelmezheti, és ilyenkor az átírás némán nem fut le. Ezen bukott el az
# első éles próbán: a /hu nem hu.html-t adott, hanem a hu/ mappára irányított.
#
# A feltételek a KÉRT címre (DOCUMENT_ROOT + REQUEST_URI) épülnek, nem a
# REQUEST_FILENAME-re: az utóbbit a MultiViews már átírhatta a .txt-re, és
# akkor a "nincs ilyen fájl" feltétel hamisan bukna el.
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Valódi mappa nyitóoldal nélkül (pl. /images/) ne fájllistát adjon, hanem
# 404-et. Ez a szabály csak az előző után futhat: a /hu ilyenkor már
# /hu.html-lé alakult, tehát nem esik ide.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

# ——— Hibaoldal ————————————————————————————————————————————————————
ErrorDocument 404 /404.html

# Fájllista tiltása a képmappákban. Csak akkor kapcsold be, ha a tárhelyen
# engedélyezett az Options felülbírálása — ha nem az, az egész .htaccess
# hibára fut (500). Előbb próbáld ki egy tesztfájllal.
# Options -Indexes

# ——— Gyorsítótár ——————————————————————————————————————————————————
# A /_next/static alatti fájlnevekben hash van, ezért korlátlanul
# gyorsítótárazhatók. A HTML mindig frissüljön, hogy a tartalmi
# javítások azonnal látszódjanak.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ——— Tömörítés ————————————————————————————————————————————————————
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ——— Karakterkódolás ——————————————————————————————————————————————
AddDefaultCharset UTF-8
