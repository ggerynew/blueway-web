RewriteRule ^termekek/gyartok/[^/]*-12/?$ https://%{HTTP_HOST}/hu/gyartok/start-international [R=301,L]
RewriteRule ^products/brands/[^/]*-3/?$ https://%{HTTP_HOST}/en/gyartok/cab [R=301,L]
RewriteRule ^products/brands/[^/]*-4/?$ https://%{HTTP_HOST}/en/termekek/szoftverek/nicelabel [R=301,L]
RewriteRule ^products/brands/[^/]*-5/?$ https://%{HTTP_HOST}/en/gyartok/tykma-electrox [R=301,L]
RewriteRule ^products/brands/[^/]*-12/?$ https://%{HTTP_HOST}/en/gyartok/start-international [R=301,L]

# Állandó lapok és a nyelvváltó.
RewriteRule ^partnereink/?$ https://%{HTTP_HOST}/hu/gyartok [R=301,L]
RewriteRule ^partners/?$ https://%{HTTP_HOST}/en/gyartok [R=301,L]
RewriteRule ^kapcsolat/?$ https://%{HTTP_HOST}/hu/kapcsolat [R=301,L]
RewriteRule ^contact/?$ https://%{HTTP_HOST}/en/kapcsolat [R=301,L]
RewriteRule ^szolgaltatasok(-\d+)?/?$ https://%{HTTP_HOST}/hu/szolgaltatasok [R=301,L]
RewriteRule ^services(-\d+)?/?$ https://%{HTTP_HOST}/en/szolgaltatasok [R=301,L]
RewriteRule ^lang/hu/?$ https://%{HTTP_HOST}/hu [R=301,L]
RewriteRule ^lang/en/?$ https://%{HTTP_HOST}/en [R=301,L]

# Amit név szerint nem ismerünk. A régi weblapnak 1-től 38-ig voltak termék-
# azonosítói, és a naplókból csak 29 került elő — a többiről nem tudjuk, mi volt.
# Ezek a gyűjtőszabályok a megfelelő listaoldalra viszik őket 404 helyett.
# Csak a fenti pontos szabályok UTÁN futhatnak.
RewriteRule ^termek(/.*)?$ https://%{HTTP_HOST}/hu/termekek [R=301,L]
RewriteRule ^product(/.*)?$ https://%{HTTP_HOST}/en/termekek [R=301,L]
RewriteRule ^termekek/gyartok(/.*)?$ https://%{HTTP_HOST}/hu/gyartok [R=301,L]
RewriteRule ^products/brands(/.*)?$ https://%{HTTP_HOST}/en/gyartok [R=301,L]
RewriteRule ^termekek(/.*)?$ https://%{HTTP_HOST}/hu/termekek [R=301,L]
RewriteRule ^products(/.*)?$ https://%{HTTP_HOST}/en/termekek [R=301,L]

# ——— Ami nem való a nyilvánosság elé ——————————————————————————————
# A régi weblap hagyatékából mentések maradtak a webgyökérben — például egy
# 95 MB-os _blueway_old.rar. A domainre átállás pillanatában ezek bárki
# számára letölthetők lennének, és egy régi weblap mentése jellemzően
# konfigurációs fájlt is tartalmaz adatbázis-jelszóval.
#
# A helyes megoldás az, hogy ezek kikerülnek a webgyökérből; ez csak
# biztonsági háló arra az esetre, ha egy ilyen fájl ottmarad vagy később
# visszakerül. A weblapnak egyetlen ilyen kiterjesztésű fájlja sincs.
#
# Miért mod_rewrite és nem <FilesMatch> + Require: a Require új
# AllowOverride jogosultságot igényelne, és ha a tárhely nem adja meg, az
# egész weblap 500-at adna. A mod_rewrite viszont biztosan engedélyezett,
# hiszen a lenti átírások is arra épülnek.
RewriteRule \.(rar|zip|7z|tar|gz|bz2|sql|bak|old|swp|log|inc)$ - [F,L]
RewriteRule (^|/)(\.git|\.env|\.htpasswd|\.user\.ini)  - [F,L]

# A deploy lenyomatlistája: minden feltöltött fájl neve és sha256 lenyomata.
# Ebből dől el, mit kell újra felküldeni — a weblap működéséhez nem kell, a
# látogatónak semmi köze hozzá. Nincs benne titok, de a szerver teljes
# fájllistáját sem kell közreadni.
RewriteRule ^deploy-manifest\.json$ - [F,L]

# FONTOS: a Next.js egyszerre készít mappát és azonos nevű .html fájlt.
# A /hu útvonalon például MINDKETTŐ létezik: a hu/ mappa (benne az aloldalak)
# és a hu.html (maga a nyitóoldal). 84 ilyen útvonal van, köztük mind a hét
# nyelvi nyitóoldal. Ezért a szabályok nem nézhetik azt, hogy a kért útvonal
# mappa-e — ha azt néznék, az Apache a mappát szolgálná ki, amiben nincs
# index.html, tehát fájllista vagy 403 jönne a nyitóoldalak helyett.
# A döntő feltétel mindenhol az, hogy létezik-e a hozzá tartozó .html.

# Záró perjeles alak: a tartalmat KISZOLGÁLJUK, nem átirányítunk.
#
# Kézenfekvő lenne a /hu/ címet a /hu-ra irányítani, de ezen a kiszolgálón
# az végtelen körhöz vezet. A mod_dir itt előbb fut, mint a mi átírásaink:
# a /hu-t — ami mappa is, mert a Next.js azonos néven mappát és .html-t is
# készít — átdobja /hu/-ra, a perjelet levágó szabály pedig vissza /hu-ra.
# Élesben ez "Maximum (50) redirects followed" hibával állt elő minden
# nyelvi nyitóoldalon.
#
# Belső átírással a kör nem jön létre: a /hu/ egyszerűen a hu.html tartalmát
# adja. A /hu-ból így egy átirányítás lesz a /hu/-ra, utána 200.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ $1.html [L]

# A Next.js minden oldalhoz készít egy azonos nevű .txt fájlt is — ez a
# böngészőn belüli lapozás adatcsomagja. A kiszolgálón be van kapcsolva a
# MultiViews tartalom-egyeztetés, ami a kiterjesztés nélküli címre MAGA
# választ változatot, és a .txt-t adja a .html helyett. A látogató ilyenkor
# nyers kódot lát a weblap helyett.
#
# Ez a szabály visszatereli az ilyen kérést a .html-re. Csak akkor fut le, ha
# a LÁTOGATÓ nem .txt-t kért: a robots.txt és a lapozás adatcsomagjai így
# változatlanul elérhetők maradnak.
RewriteCond %{REQUEST_URI} !\.txt$
RewriteRule ^(.*)\.txt$ $1.html [L]

# /hu/rolunk -> hu/rolunk.html, ha a .html létezik és nincs pontos találat.
#
# A cél RELATÍV ($1.html), nem abszolút (/$1.html). A .htaccess-ben az
# abszolút alak kétértelmű: az Apache fájlrendszerbeli útvonalként is
# értelmezheti, és ilyenkor az átírás némán nem fut le. Ezen bukott el az
# első éles próbán: a /hu nem hu.html-t adott, hanem a hu/ mappára irányított.
#
# A feltételek a KÉRT címre (DOCUMENT_ROOT + REQUEST_URI) épülnek, nem a
# REQUEST_FILENAME-re: az utóbbit a MultiViews már átírhatta a .txt-re, és
# akkor a "nincs ilyen fájl" feltétel hamisan bukna el.
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Valódi mappa nyitóoldal nélkül (pl. /images/) ne fájllistát adjon, hanem
# 404-et. Ez a szabály csak az előző után futhat: a /hu ilyenkor már
# /hu.html-lé alakult, tehát nem esik ide.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

# ——— Hibaoldal ————————————————————————————————————————————————————
ErrorDocument 404 /404.html

# Fájllista tiltása a képmappákban. Csak akkor kapcsold be, ha a tárhelyen
# engedélyezett az Options felülbírálása — ha nem az, az egész .htaccess
# hibára fut (500). Előbb próbáld ki egy tesztfájllal.
# Options -Indexes

# ——— Gyorsítótár ——————————————————————————————————————————————————
# A /_next/static alatti fájlnevekben hash van, ezért korlátlanul
# gyorsítótárazhatók. A HTML mindig frissüljön, hogy a tartalmi
# javítások azonnal látszódjanak.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ——— Biztonsági fejlécek ——————————————————————————————————————————
# Mind a hat fejléc VALÓDI BÖNGÉSZŐBEN ki lett próbálva a legyártott kimeneten,
# élesítés előtt: tíz jellemző oldalon, a térkép betöltésével, a képnagyítással
# és a 3D nézettel együtt. Egyetlen szabálysértés sem volt.
<IfModule mod_headers.c>
  # A böngésző ne találgassa a fájltípust: egy képnek látszó, valójában
  # szkriptet tartalmazó fájl így nem futhat le.
  Header always set X-Content-Type-Options "nosniff"
  # Külső oldalra csak a domain neve megy át, a teljes útvonal nem.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # A weblap nem ágyazható idegen oldalba (kattintás-eltérítés ellen).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Amire a weblapnak nincs szüksége, azt meg se kérdezhesse.
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  # A megnyitott ablakok ne férjenek hozzá egymáshoz.
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Tartalombiztonsági szabályzat: ez mondja meg, MI TÖLTHET BE egyáltalán.
  # Ha valaha bekerülne egy idegen szkript az oldalba, ez akadályozza meg,
  # hogy lefusson vagy hazatelefonáljon.
  #
  # A 'unsafe-inline' a szkripteknél sajnos kell: a Next.js soron belüli
  # indítószkriptet ír az oldalba, és a strukturált adat is így kerül bele.
  # Enélkül a weblap nem indulna el. Cserébe minden KÜLSŐ forrás tételesen
  # fel van sorolva, tehát idegen címről akkor sem tölthet be semmi.
  #
  # Kik szerepelnek és miért:
  #   gc.zgo.at, *.goatcounter.com   látogatottságmérés (szkript és a számláló)
  #   certificate.hungary.dnb.com    a naponta frissülő D&B tanúsítványkép
  #   youtube-nocookie.com           termékvideók
  #   maps.google.com, google.com    a kapcsolatoldal térképe
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://certificate.hungary.dnb.com https://*.goatcounter.com; font-src 'self'; connect-src 'self' https://gc.zgo.at https://*.goatcounter.com; frame-src https://www.youtube-nocookie.com https://maps.google.com https://www.google.com; media-src 'self'; upgrade-insecure-requests"

  # ——— HSTS — SZÁNDÉKOSAN KIKAPCSOLVA, a te döntésed ————————————
  # Ez a fejléc azt mondja a böngészőnek: ezt a domaint mostantól CSAK
  # HTTPS-en nyisd meg, a beírt http:// címet se próbáld meg. Ettől a
  # legelső látogatás utáni lehallgatás-kísérlet is kudarcba fullad.
  #
  # Amiért mégsem kapcsoltam be magamtól: ez ÍGÉRET, amit a böngésző
  # megjegyez. Ha a tanúsítvány valaha lejár vagy elromlik, a látogató nem
  # figyelmeztetést kap, hanem egyáltalán nem éri el a weblapot — és ezt
  # visszavonni csak úgy lehet, ha a max-age lejár, vagy nullára állítva
  # megvárod, míg minden böngésző újra jár nálunk.
  #
  # Ha bekapcsolod, kezdd rövid idővel (egy nap), és ha egy hónapig
  # zavartalan, emeld egy évre:
  #   Header always set Strict-Transport-Security "max-age=86400"
  #   Header always set Strict-Transport-Security "max-age=31536000"
  # Az "includeSubDomains" kapcsolót csak akkor tedd hozzá, ha MINDEN
  # aldomain (subdoms) is biztosan HTTPS-en van.

  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # A két útvonal-jegyzék KIVÉTEL. A nevükben nincs lenyomat, és a build-
  # azonosító is rögzített (lásd next.config.mjs), tehát a címük soha nem
  # változik — a tartalmuk viszont igen, valahányszor új oldal kerül a
  # weblapra. „immutable" alatt a böngésző egy évig a régit használná.
  <FilesMatch "^_(build|ssg)Manifest\.js$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ——— A lapozás adatcsomagjai ne kerüljenek a keresőbe ———————————
  # A Next.js minden oldalhoz legyárt egy azonos nevű .txt fájlt is: ez a
  # böngészőn belüli lapozás adatcsomagja, ugyanaz a tartalom nyers formában.
  # Ha a kereső ezeket is indexeli, minden oldalunk kétszer szerepel — egyszer
  # rendesen, egyszer formázatlan szövegkupacként.
  #
  # A robots.txt-ben tiltani rossz megoldás: attól a cím még bekerülhet a
  # találatok közé, csak a tartalmát nem olvashatja el a robot, hogy lássa,
  # nem oda való. Az X-Robots-Tag viszont kimondottan azt üzeni: ne indexeld.
  #
  # A robots.txt maga kivétel — arra semmilyen ilyen fejléc nem való. Ezt
  # szándékosan két lépésben oldjuk meg, nem egy tagadó előretekintéssel
  # (^(?!robots\.txt$)): a mintát itt nem tudjuk kipróbálni élesítés előtt, és
  # egy elrontott minta a .htaccess-ben nem hibás szabályt jelent, hanem 500-as
  # hibát az EGÉSZ weblapon. A `Files` szakasz ezután fut le, és visszavonja.
  <FilesMatch "\.txt$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  <Files "robots.txt">
    Header unset X-Robots-Tag
  </Files>
  # Az llms.txt és a teljes szöveges kivonat szintén kivétel: ezek kimondottan
  # a gépi olvasóknak (AI-keresők, asszisztensek) készülnek — pont az a
  # dolguk, hogy elolvassák őket.
  <Files "llms.txt">
    Header unset X-Robots-Tag
  </Files>
  <Files "llms-full.txt">
    Header unset X-Robots-Tag
  </Files>
</IfModule>

# ——— Tömörítés ————————————————————————————————————————————————————
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ——— Karakterkódolás ——————————————————————————————————————————————
AddDefaultCharset UTF-8
