# Blueway Trade — statikus weblap Apache-on (FORPSI Linux klaszter).
# A weboldal gyökerébe kell másolni, a feltöltött oldalak mellé.

# ——— Melyik fájl a nyitóoldal ————————————————————————————————————————
# A régi weblap egy PHP-alkalmazás volt, aminek a webgyökerében index.php áll.
# Az Apache alapbeállítása a legtöbb tárhelyen az index.php-t részesíti előnyben
# az index.html-lel szemben, tehát ha a régi fájl ottmarad, továbbra is az
# jelenne meg. Ezért itt kimondjuk, hogy a mi nyitóoldalunk az index.html.
DirectoryIndex index.html index.htm

# ——— Kiterjesztés nélküli URL-ek ————————————————————————————————————
# A weblap linkjei /hu/rolunk alakúak, a fájl viszont hu/rolunk.html.
# GitHub Pages ezt magától feloldja, Apache nem — enélkül minden belső
# hivatkozás 404 lenne.
RewriteEngine On

# Záró perjel levágása (a /hu/rolunk/ alak is a helyes oldalra vigyen),
# de csak akkor, ha nem létező könyvtárról van szó.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /hu/rolunk -> hu/rolunk.html, ha a .html létezik és nincs pontos találat.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ /$1.html [L]

# ——— HTTPS ————————————————————————————————————————————————————————
# Kapcsold be, MIUTÁN a tanúsítvány kiállt és a https://blueway.hu betölt.
# Előbb bekapcsolva minden látogató hibaoldalt kapna.
# RewriteCond %{HTTPS} !=on
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ——— Hibaoldal ————————————————————————————————————————————————————
ErrorDocument 404 /404.html

# ——— Gyorsítótár ——————————————————————————————————————————————————
# A /_next/static alatti fájlnevekben hash van, ezért korlátlanul
# gyorsítótárazhatók. A HTML mindig frissüljön, hogy a tartalmi
# javítások azonnal látszódjanak.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ——— Tömörítés ————————————————————————————————————————————————————
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ——— Karakterkódolás ——————————————————————————————————————————————
AddDefaultCharset UTF-8
