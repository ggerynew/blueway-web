# Kategórialapok.
RewriteRule ^termekek/kategoriak/[^/]*-1/?$ https://%{HTTP_HOST}/hu/szolgaltatasok [R=301,L]
RewriteRule ^termekek/kategoriak/[^/]*-2/?$ https://%{HTTP_HOST}/hu/termekek/cimkenyomtatok [R=301,L]
RewriteRule ^termekek/kategoriak/[^/]*-3/?$ https://%{HTTP_HOST}/hu/termekek/lezer-gravirozok [R=301,L]
RewriteRule ^termekek/kategoriak/[^/]*-4/?$ https://%{HTTP_HOST}/hu/termekek/szoftverek [R=301,L]
