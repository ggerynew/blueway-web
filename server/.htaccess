RewriteRule ^product/[^/]*-6/?$ https://%{HTTP_HOST}/en/termekek/szoftverek/nicelabel [R=301,L]
RewriteRule ^product/[^/]*-8/?$ https://%{HTTP_HOST}/en/termekek/cimkek-es-festekszalagok [R=301,L]
