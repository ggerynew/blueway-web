{
  "name": "blueway-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --experimental-strip-types --import ./scripts/ts-betolto.mjs scripts/finalize-static.mjs && node --experimental-strip-types --import ./scripts/ts-betolto.mjs scripts/ai-kivonat.ts",
    "start": "next start",
    "lint": "next lint",
    "build:live": "STATIC_EXPORT=1 NEXT_PUBLIC_BASE_PATH= NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-https://blueway.hu} NEXT_PUBLIC_FORM_ENDPOINT=${NEXT_PUBLIC_FORM_ENDPOINT:-https://blueway.hu/send.php} NEXT_PUBLIC_GOATCOUNTER_CODE=${NEXT_PUBLIC_GOATCOUNTER_CODE:-blueway} npm run build",
    "masc:asztal": "npm --prefix masc-feltolto run asztal",
    "masc:felderit": "npm --prefix masc-feltolto run felderit --",
    "masc:feltolt": "npm --prefix masc-feltolto run feltolt --",
    "masc:teszt": "npm --prefix masc-feltolto run teszt",
    "masc:ellenoriz": "npm --prefix masc-feltolto run ellenoriz"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.10.71",
    "motion": "^12.23.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  }
}
