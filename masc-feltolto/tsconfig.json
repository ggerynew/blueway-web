{
  // A program NEM a weblap része: Node és Electron alatt fut, nem böngészőben.
  //
  // Miért fordítunk, holott a parancssori változat futásidejű
  // típuslevetkőzéssel is elmenne: az Electron a fő folyamatot nem tudja
  // futásidőben levetkőztetni, a telepítőbe pedig kész JavaScript kell.
  // Egyetlen modell van tehát: a forrás TypeScript, a kimenet a dist/ alatt.
  //
  // Ezért hivatkoznak az importok .js-re, holott a fájl .ts — ez az ESM
  // szabvány útja: az import a KIMENETI fájlnevet nevezi meg.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "asztali/**/*.ts"]
}
