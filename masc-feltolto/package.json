{
  "name": "masc-feltolto",
  "version": "2.0.0",
  "private": true,
  "description": "Bizonylatok feltöltése a MASC (masc.hu) elFinder fájlkezelőjébe — több cég, Windows asztali felülettel.",
  "type": "module",
  "main": "dist/asztali/fo.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "epit": "tsc -p tsconfig.json",
    "asztal": "npm run epit && electron .",
    "felderit": "npm run epit && node dist/src/index.js felderit",
    "feltolt": "npm run epit && node dist/src/index.js feltolt",
    "teszt": "npm run epit && node --test teszt/feltolto.teszt.mjs teszt/asztali.teszt.mjs",
    "ellenoriz": "tsc -p tsconfig.json --noEmit",
    "epit:windows": "npm run epit && electron-builder --win --publish never",
    "teszt:felulet": "node --test teszt/felulet.teszt.mjs",
    "teszt:mind": "npm run teszt && npm run teszt:felulet"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "hu.blueway.masc-feltolto",
    "productName": "MASC bizonylat-feltolto",
    "directories": {
      "output": "kiadas"
    },
    "files": [
      "asztali/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MASC bizonylat-feltöltő"
    }
  }
}
